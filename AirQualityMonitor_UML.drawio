  <diagram name="Page-1" id="9jkDTaSBAH5O86rok6Rt">
    <mxGraphModel dx="4443" dy="2852" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nnamespace app {\n    class Main {\n        +main(String[] args) void\n        +createMonitor() AirQualityMonitor\n    }\n}\n\nnamespace model {\n    class Area {\n        -String name\n        -Sensor sensor\n        +Area(String, Sensor)\n        +getName() String\n        +getSensor() Sensor\n    }\n\n    class Reading {\n        -String areaName\n        -int aqi\n        -LocalDateTime timestamp\n        +Reading(String, int)\n        +getAreaName() String\n        +getAqi() int\n        +getTimestamp() LocalDateTime\n        +classify() AirQualityLevel\n    }\n\n    class AirQualityLevel {\n        &lt;&lt;enumeration&gt;&gt;\n        GOOD\n        MODERATE\n        POOR\n        SEVERE\n    }\n}\n\nnamespace sensor {\n    class Sensor {\n        &lt;&lt;Thread&gt;&gt;\n        -String sensorId\n        -String areaName\n        -Reading latestReading\n        -Random random\n        +Sensor(String, String)\n        +run() void\n        +generateReading() Reading\n        +getLatestReading() Reading\n        +getSensorId() String\n        +getAreaName() String\n    }\n}\n\nnamespace service {\n    class AirQualityMonitor {\n        -ArrayList~Area~ areas\n        -ArrayList~Reading~ readings\n        -AlertService alertService\n        -ReportService reportService\n        +registerArea(Area) void\n        +generateReadings() void\n        +compareAreas() void\n        +getWorstArea() Area\n        +saveReport() void\n        +checkHazardousAir(Reading) void\n    }\n\n    class AlertService {\n        -Map~AirQualityLevel, String~ adviceMap\n        +sendAlert(String, int, AirQualityLevel) void\n        +getHealthAdvice(AirQualityLevel) String\n    }\n\n    class ReportService {\n        -String filePath\n        +saveReport(List~Reading~) void\n        +writeToFile(String) void\n    }\n}\n\nnamespace exception {\n    class HazardousAirException {\n        +HazardousAirException(String)\n    }\n}\n\nArea \&quot;1\&quot; --&gt; \&quot;1\&quot; Sensor : has\nSensor ..&gt; Reading : generates\nReading ..&gt; AirQualityLevel : classifies using\nAirQualityMonitor \&quot;1\&quot; o-- \&quot;0..*\&quot; Area : manages\nAirQualityMonitor \&quot;1\&quot; o-- \&quot;0..*\&quot; Reading : stores\nAirQualityMonitor --&gt; AlertService : uses\nAirQualityMonitor --&gt; ReportService : uses\nAirQualityMonitor ..&gt; HazardousAirException : throws\nHazardousAirException --|&gt; Exception : extends\nMain ..&gt; AirQualityMonitor : creates and runs\nAlertService ..&gt; AirQualityLevel : uses\nReportService ..&gt; Reading : saves&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="7XjAy_-E7pSCNMG0SpqI-1">
